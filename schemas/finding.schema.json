{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/cpr/finding.schema.json",
  "title":"CPR Finding",
  "type":"object",
  "additionalProperties":false,
  "required":["finding_id","skill_id","chapter_id","version_id","stage","status","risk_level","object_or_file","location","observed_fact","authority","reason","owner","next_action","confidence","intervention","release_effect","closure_condition","created_at","updated_at"],
  "properties":{
    "finding_id":{"type":"string","pattern":"^CPR-FND-"},
    "skill_id":{"type":"string","pattern":"^CPR-[0-9]{2}$"},
    "chapter_id":{"type":"string"},
    "version_id":{"type":"string"},
    "stage":{"type":"string","enum":["intake","copyedit_handoff","production_handoff","proof_intake","release"]},
    "status":{"type":"string","enum":["open","tracked","query_sent","routed","hold","blocked","resolved","not_applicable"]},
    "risk_level":{"type":"string","enum":["low","medium","high","critical"]},
    "object_or_file":{"type":"string"},
    "location":{"type":"object","additionalProperties":false,"required":["locator"],"properties":{"locator":{"type":"string"},"page":{"type":["integer","null"]},"object_id":{"type":["string","null"]},"file_id":{"type":["string","null"]}}},
    "observed_fact":{"type":"string"},
    "authority":{"type":"string"},
    "reason":{"type":"string"},
    "owner":{"type":"string"},
    "next_action":{"type":"string"},
    "confidence":{"type":"string","enum":["high","medium","low"]},
    "intervention":{"type":"string","enum":["AUTO_RECORD","TRACK","QUERY","ROUTE","HOLD","BLOCK","PASS"]},
    "release_effect":{"type":"string","enum":["none","track","hold","block"]},
    "dependency_ids":{"type":"array","items":{"type":"string"}},
    "response":{"type":["object","null"],"additionalProperties":false,"properties":{"response_id":{"type":"string"},"received_at":{"type":"string","format":"date-time"},"summary":{"type":"string"},"status":{"type":"string","enum":["open","received","accepted","disputed"]},"respondent":{"type":"string"}}},
    "closure_condition":{"type":"string"},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"}
  }
}
