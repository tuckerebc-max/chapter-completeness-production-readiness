{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPR artifact fixity instrument input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "target",
    "candidate",
    "saved",
    "review"
  ],
  "properties": {
    "contract_version": {
      "const": "cpr-artifact-fixity/1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version_id",
        "sha256",
        "authority_ref"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "saved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version_id",
        "sha256",
        "path",
        "receipt_ref"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "receipt_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version_id",
        "sha256",
        "review_ref"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "historical_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "version_id",
          "sha256",
          "receipt_ref"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "version_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "receipt_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
