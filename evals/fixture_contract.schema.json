{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/cpr/fixture-contract.schema.json",
  "title":"CPR Evaluation Fixture Contract",
  "type":"object",
  "additionalProperties":false,
  "required":["fixture_id","kind","title","synthetic","input","gold"],
  "properties":{
    "fixture_id":{"type":"string","pattern":"^FX-(CLEAN|ERR|ADV|NEG|INT)-[0-9]{3}$"},
    "kind":{"type":"string","enum":["clean","single_error","adversarial","negative_control","integration"]},
    "title":{"type":"string"},
    "synthetic":{"const":true},
    "input":{"type":"object"},
    "gold":{"type":"object","additionalProperties":false,"required":["expected_release_status","expected_rule_ids","expected_interventions","must_not_emit_rule_ids"],"properties":{"expected_release_status":{"type":"string","enum":["ready","ready_with_tracked_items","conditional_hold","hold","blocked","not_ready"]},"expected_rule_ids":{"type":"array","items":{"type":"string","pattern":"^CPR-"}},"expected_interventions":{"type":"array","items":{"type":"string","enum":["AUTO_RECORD","TRACK","QUERY","ROUTE","HOLD","BLOCK","PASS"]}},"expected_statuses":{"type":"array","items":{"type":"string"}},"expected_hooks":{"type":"array","items":{"type":"string","pattern":"^CPR-DH-"}},"expected_routes":{"type":"array","items":{"type":"string"}},"must_not_emit_rule_ids":{"type":"array","items":{"type":"string","pattern":"^CPR-"}},"zero_tolerance":{"type":"array","items":{"type":"string"}}}}
  }
}
